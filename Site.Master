<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="AfterSchoolAdmission.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Bright Minds After School Admission Center</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Custom Stylesheet -->
    <link href="CSS/custom.css" rel="stylesheet" type="text/css" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div id="wrapper">
            <!-- Sidebar Navigation -->
            <nav id="sidebar">
                <a href="Dashboard.aspx" class="sidebar-brand">
                    <i class="fa-solid fa-graduation-cap"></i>
                    <span>Bright Minds</span>
                </a>
                <ul class="nav flex-column mt-3">
                    <li class="nav-item">
                        <a class="nav-link <%: Page.Title == "Dashboard" ? "active" : "" %>" href="Dashboard.aspx">
                            <i class="fa-solid fa-gauge-high"></i> Dashboard
                        </a>
                    </li>

                    <div class="nav-category">Admission & Students</div>
                    <li class="nav-item">
                        <a class="nav-link <%: Page.Title == "New Admission" ? "active" : "" %>" href="Admission.aspx">
                            <i class="fa-solid fa-user-plus"></i> New Admission
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%: Page.Title == "Student Directory" ? "active" : "" %>" href="StudentList.aspx">
                            <i class="fa-solid fa-users"></i> All Students
                        </a>
                    </li>

                    <div class="nav-category">Attendance</div>
                    <li class="nav-item">
                        <a class="nav-link <%: Page.Title == "Mark Attendance" ? "active" : "" %>" href="MarkAttendance.aspx">
                            <i class="fa-solid fa-clipboard-user"></i> Mark Attendance
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%: Page.Title == "Attendance Reports" ? "active" : "" %>" href="AttendanceReport.aspx">
                            <i class="fa-solid fa-chart-column"></i> Attendance Logs
                        </a>
                    </li>

                    <div class="nav-category">Fee Management</div>
                    <li class="nav-item">
                        <a class="nav-link <%: Page.Title == "Fee Payment" ? "active" : "" %>" href="FeePayment.aspx">
                            <i class="fa-solid fa-credit-card"></i> Collect Fee
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%: Page.Title == "Pending Fees" ? "active" : "" %>" href="PendingFees.aspx">
                            <i class="fa-solid fa-triangle-exclamation"></i> Pending Fees
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%: Page.Title == "Fee History" ? "active" : "" %>" href="FeeHistory.aspx">
                            <i class="fa-solid fa-receipt"></i> Payment History
                        </a>
                    </li>

                    <div class="nav-category">Reports & Account</div>
                    <li class="nav-item">
                        <a class="nav-link <%: Page.Title == "Reports Hub" ? "active" : "" %>" href="Reports.aspx">
                            <i class="fa-solid fa-file-invoice"></i> Reports Hub
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%: Page.Title == "Change Password" ? "active" : "" %>" href="ChangePassword.aspx">
                            <i class="fa-solid fa-key"></i> Change Password
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-danger" href="Logout.aspx">
                            <i class="fa-solid fa-right-from-bracket"></i> Logout
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- Content Area -->
            <div id="content-wrapper">
                <!-- Topbar -->
                <header class="topbar">
                    <button type="button" class="toggle-sidebar-btn" id="sidebarToggle">
                        <i class="fa-solid fa-bars"></i>
                    </button>

                    <div class="d-flex align-items-center gap-3">
                        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-semibold">
                            Academic Year: 2026-2027
                        </span>
                        <div class="user-profile">
                            <div class="avatar-circle">
                                <asp:Literal ID="litUserInitial" runat="server" Text="A"></asp:Literal>
                            </div>
                            <div>
                                <div class="fw-bold fs-6 mb-0">
                                    <asp:Literal ID="litAdminName" runat="server" Text="Admin"></asp:Literal>
                                </div>
                                <small class="text-muted">Administrator</small>
                            </div>
                        </div>
                    </div>
                </header>

                <!-- Page Main Content -->
                <main class="main-content">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </main>
            </div>
        </div>
    </form>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- HTML2PDF Library for PDF Exports -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <!-- Custom Application JS -->
    <script src="JS/main.js"></script>
</body>
</html>
